@using System.Linq
@{
    ViewData["Title"] = "Blog Page";
}
<!-- Banner -->
<div class="main-banner">
    <div class="spacerX">
        <div class="row">
            <div class="col-12 text-center">
                <h1>Our Blog</h1>
                <p>We strive to elevate the food experience</p>
            </div>
        </div>
    </div>
</div>

<!-- Blog -->
<section class="sec-margin">
    <div class="spacerX">

        <div class="row">
            <div class="col-12 col-lg-8 order-2 order-lg-1 ">
                @if (ViewBag.Blogs != null && ViewBag.Blogs.Count > 0)
                {
                    foreach (var blog in ViewBag.Blogs)
                    {
                        <div class="BlogPost d-flex">
                            <div class="BlogDate d-none d-md-block">
                                <div class="Hexagon">
                                    <div>
                                        <h4 class="d-block">@blog.CreatedAt.ToString("dd")</h4>
                                        <p>@blog.CreatedAt.ToString("MMMM")<br>@blog.CreatedAt.ToString("yyyy")</p>
                                    </div>
                                </div>
                                <span class="BlogPost-Name">
                                    by <br> Admin
                                </span>
                            </div>
                            <div class="Blog-Post">
                                <div class="BlogImage">
                                    <img src="~/uploads/blog/@blog.Image" alt="" class="img-fluid">
                                    <div class="BlogDate-sm d-md-none">
                                        <p>@blog.CreatedAt.ToString("dd")/@blog.CreatedAt.ToString("MMMM")/@blog.CreatedAt.ToString("yyyy")</p>
                                    </div>
                                </div>
                                <div class="BlogPost-Content">
                                    <div class="BlogPost-Category">
                                        <p>Category</p>
                                        <span class="CategoryDots"></span>
                                        <p>@blog.Category.CategoryName</p>
                                        <div class="d-md-none ms-auto text-lowercase">
                                            <p>by Admin</p>
                                        </div>
                                    </div>
                                    <div class="BlogPost-details">
                                        <h3>@blog.Title</h3>

                                        <p class="BlogPost-Desc">
                                            @blog.Description
                                        </p>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mt-4">
                                        <div class="socialIcon">
                                            <a href="#">
                                                <i class="ri-facebook-fill"></i>
                                            </a>
                                            <a href="#">
                                                <i class="ri-twitter-fill"></i>
                                            </a>
                                            <a href="#">
                                                <i class="ri-linkedin-fill"></i>
                                            </a>
                                            <a href="#">
                                                <i class="ri-google-fill"></i>
                                            </a>
                                        </div>

                                        <div class="continueBtn">
                                            <a href="#" class="d-inline-flex align-items-center">
                                                CONTINUE READING
                                                <i class="ri-arrow-right-line ms-2"></i>
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
                <div class="row pagination">
                    <div class="col-12 d-flex justify-content-center ">
                        <ul class="d-flex align-items-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li>
                                    <a href="@Url.Action("Blog", new { page = ViewBag.CurrentPage - 1 })"
                                       class="pagination-arrow">
                                        <i class="ri-arrow-left-s-line"></i>
                                    </a>
                                </li>
                            }
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li>
                                    <a href="@Url.Action("Blog", new { page = i })"
                                       class="@(ViewBag.CurrentPage == i ? "active" : "")">
                                        @i
                                    </a>
                                </li>
                            }
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li>
                                    <a href="@Url.Action("Blog", new { page = ViewBag.CurrentPage + 1 })"
                                       class="pagination-arrow">
                                        <i class="ri-arrow-right-s-line"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4 order-1 order-lg-2 mb-5 padding-none">
                <div class="row">
                    <div class="col-12 col-md-6 col-lg-12 padding-none">
                        <div class="categories-box">
                            <div class="categories-Heading">
                                <h6>Categories</h6>
                            </div>
                            <div class="categories-list">
                                <ul>
                                    @if (ViewBag.Categories != null && ViewBag.Categories.Count > 0)
                                    {
                                        foreach (var category in ViewBag.Categories)
                                        {
                                            <li class="categories-items">
                                                <img src="~/uploads/category/@category.CategoryImage" alt="@category.CategoryName" class="img-fluid">
                                                <h6>@category.CategoryName</h6>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                     <li>No categories available. sss</li>
                                    }
                                    
                                </ul>

                            </div>
                            <a href="#" class="AllCategories">
                                All Categories
                            </a>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-12 padding-none">
                        <div class="Recent-box mt-5 ">
                            <div class="Recent-Heading">
                                <h6>Recent Posts</h6>
                            </div>
                            <div class="categories-list ">
                                <ul>
                                    @if (ViewBag.RecentBlogs != null && ViewBag.RecentBlogs.Count > 0)
                                    {
                                        @foreach (var blog in ViewBag.RecentBlogs)
                                        {
                                            <li class="Recent-items">
                                                    <img src="~/uploads/blog/@blog.Image" alt="" class="img-fluid">
                                                <div class="Recentpost-content">
                                                    @if (blog.CreatedAt != null)
                                                    {
                                                        <p>@blog.CreatedAt.ToString("MMMM dd, yyyy")</p>
                                                    }
                                                    <h6 class="fw-bolder mt-1">
                                                          @blog.Title
                                                    </h6>
                                                </div>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li>No recent posts available.</li>
                                    }
                                </ul>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>