@{
    ViewData["Title"] = "Contact Us Page";
}
<div class="Blog">
    <div class="main-banner">
        <div class="spacerX">
            <div class="row">
                <div class="col-12 text-center">
                    <h1>Contact Us</h1>
                    <p>Any Questions of remarks? Just write us a message !</p>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="contact-location position-relative">
    <img src="~/front/images/location.png" alt="" class="location-image d-none d-md-block">
    <div class="spacerX">
        <div class="row iframeform-bg">
            <div class="col-12 col-md-5">
                <h5>Contact Us</h5>
                <p class="fs-4 mt-4">
                    if you like you know more about our policies, you can consult out Terms and
                    condition. you will
                    also be able to follow your order(Tracking number will be provided in an e-mail after ordering.
                    ). You widh to return some times? <a href="#">Click Here</a>.
                </p>


                <ul class="mt-5 contact-list">
                    <li class="d-flex ">
                        <i class="ri-map-pin-line fs-1 me-4"></i>
                        <div>
                            <h6>Address</h6>
                            <p>Amartek Buillding County Hall, </p>
                            <p>New Delhi DG 7ND, india</p>
                        </div>
                    </li>
                    <li class="d-flex mt-5">
                        <i class="ri-map-pin-line fs-1 me-4"></i>
                        <div>
                            <h6>Phone</h6>
                            <p>91 67899 54434</p>
                        </div>
                    </li>
                    <li class="d-flex  mt-5">
                        <i class="ri-mail-line fs-1 me-4"></i>
                        <div>
                            <h6>Email</h6>
                            <p>help@example.com</p>
                        </div>
                    </li>
                    <li class="d-flex mt-5">
                        <i class="ri-time-line fs-1 me-4"></i>
                        <div>
                            <h6>Open Hours</h6>
                            <p>Monday to Friday 09:30 - 17:30</p>
                            <p>Saturday & Sunday 10:00 - 15:00</p>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-7 mt-4 mt-md-0 p-0">
                <form class="contact-us-form" id="contactForm">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <label for="exampleInputEmail1" class="form-label">Your name <sup>*</sup></label>
                            <input name="Name" type="text" class="form-control" id="Name" aria-describedby="emailHelp">
                        </div>

                        <div class="col-12 col-sm-6 mt-3 mt-sm-0">
                            <label for="Email" class="form-label">
                                Your email
                                <sup>*</sup>
                            </label>
                            <input type="email" class="form-control" id="Email" name="Email">
                        </div>

                        <div class="col-12 col-sm-6 mt-3 mt-sm-5">
                            <label for="Phone" class="form-label">Your Phone</label>
                            <input type="text" class="form-control" id="Phone" aria-describedby="Phone" name="Phone">
                        </div>

                        <div class="col-12 col-sm-6 mt-3 mt-sm-5">
                            <label for="exampleInputPassword1" class="form-label">Select Reason</label>
                            <input type="text" class="form-control" id="Reason" name="Reason">
                        </div>

                        <div class="col-12 mt-5">
                            <label for="exampleInputPassword1" class="form-label">Youe Message</label>
                            <textarea rows="4" class="w-100" id="Message" name="Message"></textarea>
                        </div>

                        <div class="col-12 checkbox-form mt-4">
                            <div class=" form-check d-flex align-items-center">
                                <input type="checkbox" class="form-check-input" id="exampleCheck1">
                                <label class="form-check-label ms-2" for="exampleCheck1">
                                    save my name, email and
                                    website in this browser for the next time i comment.
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mt-5">
                            <button type="submit" class="btn send-msg-btn">Send Message</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>



    <div class="order-summary-bg">
        <div class="spacerX">
            <div class="row justify-content-center justify-content-md-start">
                <div class="col-12 col-sm-10 col-md-6 col-lg-4 order-card">
                    <div class="OSB-card-border">
                        <img src="~/front/images/delivery.png" alt="">

                        <div class="ms-4">
                            <h6>24 Hours Online Ordering</h6>
                            <p>Everything you order will be quickly delivery to your door</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-10 col-md-6 col-lg-4 order-card mt-4 mt-md-0">
                    <div class="OSB-card-border">
                        <img src="~/front/images/safe.png" alt="">

                        <div class="ms-4">
                            <h6>Safe and Secure Delivery</h6>
                            <p>Everything you order will be quickly delivery to your door</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-10 col-md-6 col-lg-4 order-card mt-4 mt-lg-0">
                    <div class="OSB-card-border">
                        <img src="~/front/images/order.png" alt="">

                        <div class="ms-4 special-call">
                            <h6>For Special Orders</h6>
                            <p>Call : 0982 348 599</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="fast-delivery-banner">

        <div class="row order-content-bg">
            <div class="col-12 col-sm-6 order-content">
                <h4 class="fw-bold mb-3">Fast Delivery</h4>
                <p>You're having a meeting working late at night and need an extra push.</p>
                <p>Let us know and well be there</p>

                <div class="order-now mt-5">
                    <a href="#">Order Now</a>
                </div>
            </div>
        </div>
    </div>

    <div class="spacerX mt-5 mt-sm-0">
        <div class="row services-menu">
            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-lg-content-center">
                <img src="~/front/images/menu1.png" alt="" class="menu-img">

                <div class="services-menu-item ms-4">
                    <h1>60+</h1>
                    <h6>Menu Item</h6>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-lg-content-center mt-4 mt-sm-0">
                <img src="~/front/images/menu2.png" alt="" class="menu-img">

                <div class="services-menu-item ms-4">
                    <h1>280+</h1>
                    <h6>Visitor Everyday</h6>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-lg-content-center mt-4 mt-lg-0">
                <img src="~/front/images/menu3.png" alt="" class="menu-img">

                <div class="services-menu-item ms-4">
                    <h1>280+</h1>
                    <h6>Year of Experience</h6>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-lg-content-center mt-4 mt-lg-0">
                <img src="~/front/images/menu4.png" alt="" class="menu-img">

                <div class="services-menu-item ms-4">
                    <h1>100+</h1>
                    <h6>Taste & Fun</h6>
                </div>
            </div>
        </div>
    </div>

@section Scripts{

    <script>

                 $(function () {

                    $("#contactForm").validate({
                        errorClass: "text-danger",
                        rules: {
                            Name: {
                                required: true,
                                minlength: 3
                            },
                            Email: {
                                required: true,
                                email: true
                            },
                            Phone: {
                                required: true
                            },
                            Reason: {
                                required: true
                            },
                            Message: {
                                required: true,
                                minlength: 10
                            }
                        },

                        messages: {
                            Name: "Enter your name",
                            Email: "Enter a valid email",
                            Phone: "Enter phone number",
                            Reason: "Enter reason",
                            Message: "Enter message"
                        },

                        submitHandler: function (form) {

                            $.ajax({

                                url: '/Home/ContactCreate',

                                type: 'POST',

                                data: $(form).serialize(),

                                success: function (response) {
                                    console.log(response);

                                    if (response.success) {
                                        toastr.success(response.message);
                                        form.reset();
                                    } else {
                                        toastr.error(response.message);
                                    }

                                },

                                error: function () {
                                    toastr.error("Something went wrong.");
                                }

                            });

                            return false;
                        }

                    });

                });

    </script>

}
