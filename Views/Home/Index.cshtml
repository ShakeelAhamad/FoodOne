<!-- RESERVATION -->
<section class="Reservation">
    <div>
        <div class="row Section-Heading">
            <div class="col-12 text-center">
                <h4 class=" ">RESERVATION</h4>
                <h3 class="fw-bolder">Book Your Table</h3>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-10 col-sm-8 col-md-8 col-lg-9 col-xl-8 col-xxl-7">
                <form class="Reservation-Form">
                    <ul class="row">
                        <li class="col-12 col-lg-6">
                            <input type="text" class="form-control" aria-describedby="emailHelp" placeholder="NAME">
                        </li>

                        <li class="col-12 col-lg-6">
                            <input type="text" class="form-control" aria-describedby="emailHelp"
                                   placeholder="EMAIL">
                        </li>

                        <li class="col-12 col-lg-6">
                            <input type="text" class="form-control" aria-describedby="emailHelp" placeholder="DATE">
                        </li>

                        <li class="col-12 col-lg-6">
                            <input type="text" class="form-control" aria-describedby="emailHelp" placeholder="TIME">
                        </li>

                        <li class="col-12 col-lg-6">
                            <input type="text" class="form-control" aria-describedby="emailHelp"
                                   placeholder="PEOPLE">
                        </li>

                        <li class="col-12 col-lg-6">
                            <button type="submit" class="btn Form-Submit">FIND A TABLE</button>
                        </li>
                    </ul>
                </form>
            </div>
        </div>
    </div>
</section>
