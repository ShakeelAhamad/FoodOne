@{
    ViewData["Title"] = "Home Page";
}

@model List<FoodOne.Models.Category>
<!-- Slider -->
<div class="owl-carousel owl-theme banner-bg-image">
    <div class="item d-flex justify-content-center">
        <div class="row align-items-center w-100">
            <div class="col-12 col-sm-6 d-flex justify-content-center slider-content">
                <div class="details">
                    <div class="column first-slide">
                        <h3 class="wow animate__slideInUp" data-wow-duration="1s">Loaded</h3>
                        <h1 class="wow animate__slideInUp" data-wow-duration="2s">Burguer</h1>
                        <div class="wow animate__slideInUp mt-4" data-wow-duration="3s">
                            <h4>Medium 2-topping*</h4>
                            <p>*Additional charge for premium toppings. Minimum of 2 required.</p>
                        </div>

                        <div class=" mt-5 title d-flex align-items-center wow wow animate__slideInUp"
                             data-wow-duration="4s">
                            <a href="#" class="order-now">ORDER NOW</a>
                            <span class="food-price ms-5">
                                <strong>Rs 119</strong>
                                <del>Rs 135</del>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 wow animate__slideInDown d-none d-sm-block" data-wow-duration="1s">
                <img src="~/front/images/Burger.png" alt="" class="img-fluid mx-auto">
            </div>
        </div>
    </div>

    <div class="item d-flex justify-content-center">
        <div class="row align-items-center w-100">
            <div class="col-12 col-sm-6 d-flex justify-content-center slider-content">
                <div class="details">
                    <div class="column first-slide">
                        <h3 class="wow animate__slideInDown" data-wow-duration="4s">Loaded</h3>
                        <h1 class="wow animate__slideInDown" data-wow-duration="3s">Pizza</h1>
                        <div class="wow animate__slideInDown" data-wow-duration="2s">
                            <h4>Medium 2-topping*</h4>
                            <p>*Additional charge for premium toppings. Minimum of 2 required.</p>
                        </div>

                        <div class=" mt-5 title d-flex align-items-center wow animate__slideInDown"
                             data-wow-duration="1s">
                            <a href="#" class="order-now">ORDER NOW</a>
                            <span class="food-price ms-5">
                                <strong>Rs 119</strong>
                                <del>Rs 135</del>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 d-none d-sm-block wow animate__slideInUp" data-wow-duration="1s">
                <img src="front/images/pizza.png" alt="" class="img-fluid mx-auto">
            </div>
        </div>
    </div>

    <div class="item d-flex justify-content-center">
        <div class="row align-items-center w-100">
            <div class="col-12 col-sm-6 d-flex justify-content-center align-items-center slider-content">
                <div class="details">
                    <div class="column first-slide">
                        <h3 class="wow animate__slideInUp" data-wow-duration="1s">Loaded</h3>
                        <h1 class="wow animate__slideInUp" data-wow-duration="2s">Frankie</h1>
                        <div class="wow animate__slideInUp" data-wow-duration="3s">
                            <h4>Medium 2-topping*</h4>
                            <p>*Additional charge for premium toppings. Minimum of 2 required.</p>
                        </div>

                        <div class=" mt-5 title d-flex align-items-center wow animate__slideInUp"
                             data-wow-duration="4s">
                            <a href="#" class="order-now">ORDER NOW</a>
                            <span class="food-price ms-5">
                                <strong>Rs 119</strong>
                                <del>Rs 135</del>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 d-none d-sm-flex justify-content-center wow animate__slideInDown"
                 data-wow-duration="1s">
                <img src="~/front/images/francky.png" alt="" class="img-fluid mx-auto">
            </div>
        </div>
    </div>
</div>

<section class="spacerX mt-5">
    <div class="special-menu  food-gallery">
        <div class="row button-group filters-button-group  justify-content-center ">
            <div class="col-auto mt-3 d-flex align-items-center justify-content-center me-sm-4">
                <div class="borders-All">
                    <button class="button is-checked color-All" data-filter="*">
                        <p class="fw-bold fs-2">All</p>
                    </button>
                </div>
            </div>
            @if (Model != null && Model.Any())
            {
                int index = 1;

                @foreach (var item in Model)
                {
                    <div class="col-auto mt-3 d-flex align-items-center justify-content-center me-sm-4">
                        <div class="borders-2">
                            <button class="button is-checked color-@index" data-filter=".@item.CategoryName">
                                <img src="~/uploads/category/@item.CategoryImage" alt="">
                                <p class="fw-bold">@item.CategoryName</p>
                            </button>
                        </div>
                    </div>
                    index++;
                }
            }
