
@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>

    <meta charset="utf-8" />
    <title>Sign In | Admin & Dashboard </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Premium Multipurpose Admin & Dashboard" name="description" />
    <meta content="Themesbrand" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/admin/images/favicon.ico">

    <!-- Layout config Js -->
    <script src="~/admin/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/admin/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/admin/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- custom Css-->
    <link href="~/admin/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/front/css/toastr.min.css">
</head>

<body>
    <!-- auth-page wrapper -->
    <div class="auth-page-wrapper auth-bg-cover py-5 d-flex justify-content-center align-items-center min-vh-100">
        <div class="bg-overlay"></div>
        <!-- auth-page content -->
        <div class="auth-page-content overflow-hidden pt-lg-5">
            <div class="container">
                @RenderBody()
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
        <!-- footer -->
        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center">
                            <p class="mb-0">
                                &copy;
                                <script>document.write(new Date().getFullYear())</script> Construction.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- end auth-page-wrapper -->
    <!-- JAVASCRIPT -->
    <script src="~/admin/libs/jquery/jquery-3.6.0.min.js"></script>
    <script src="~/admin/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/libs/simplebar/simplebar.min.js"></script>
    <script src="~/admin/libs/node-waves/waves.min.js"></script>
    <script src="~/admin/libs/feather-icons/feather.min.js"></script>
    <script src="~/admin/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/front/js/toastr.min.js"></script>
    <script src="~/admin/js/plugins.js"></script>
    <!-- password-addon init -->
    <script src="~/admin/js/pages/password-addon.init.js"></script>
    @await RenderSectionAsync("LoginScripts", required: false)
</body>

</html>
