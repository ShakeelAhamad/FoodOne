@{
    ViewBag.Title = "Change Password";
}
@model FoodOne.ViewModels.ChangePasswordViewModel
<div class="container-fluid">
    <div class="row">
        <div class="col">
            <div class="h-100">
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                            <h4 class="mb-sm-0">@ViewBag.Title</h4>
                            <div class="page-title-right">
                                <ol class="breadcrumb m-0">
                                    <li class="breadcrumb-item">@ViewBag.Title</li>
                                    <li class="breadcrumb-item active">Update</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    <!--end col-->
                </div>

                <div class="row justify-content-center">
                    <div class="col-xl-8">
                        <div class="card">
                            <div class="card-body">
                                <form id="PasswordForm" asp-area="Admin" asp-action="UpdatePassword" asp-controller="Profile" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label">Current Password</label>
                                        <input type="password" asp-for="CurrentPassword" id="CurrentPassword " class="form-control" />
                                        <span asp-validation-for="CurrentPassword" class="invalid-feedback"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">New Password</label>
                                        <input type="password" asp-for="NewPassword" id="NewPassword" class="form-control" />
                                        <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Confirm Password</label>
                                        <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" />
                                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                                    </div>
                                    <div class="card-footer">
                                        <button type="submit" class="btn btn-primary"> <i id="btn_spin"></i> Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end row-->
            </div> <!-- end .h-100-->
        </div> <!-- end col -->
    </div>
</div>
@section Scripts {
    <script>
        $(function() {
            $('#PasswordForm').submit(function(e) {
                e.preventDefault();
                $('.invalid-feedback').text('').removeClass('d-block');
                $('#PasswordForm').find('.is-invalid').removeClass('is-invalid');
                var fd = new FormData(this);
                $.ajax({
                    url: $(this).attr('action') || '/admin/profile/update-password',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $("#btn_spin").addClass("spinner-border spinner-border-sm");
                    },
                    complete: function () {
                        $("#btn_spin").removeClass('spinner-border spinner-border-sm');
                    },
                    success: function (res) {
                        if (res && res.success) {
                            toastr.success(res.message);
                            $('#PasswordForm')[0].reset();
                            setTimeout(function () {
                                window.location.href = res.redirectUrl;
                            }, 1500);
                        } else if (res && res.errors) {
                            $.each(res.errors, function (field, msgs) {
                                var key = field.split('.').pop();
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error(res.message || 'Save failed');
                    }, error: function (xhr) {
                        var json;
                        try {
                            json = xhr.responseJSON || JSON.parse(xhr.responseText);
                        } catch (e) {
                        } if (json && json.errors) {
                            $.each(json.errors, function (field, msgs) {
                                var key = field.split('.').pop();
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error('Server error');
                    }
                });
            });
        });
    </script>
}