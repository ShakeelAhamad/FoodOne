@model string
@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Admin/Shared/_LayoutLogin.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card overflow-hidden">
            <div class="row g-0">
                <div class="col-lg-6">
                    <div class="p-lg-5 p-4">
                        <div>
                            <h5 class="text-primary">Forgot Password !</h5>
                        </div>
                        <div class="mt-4">
                            <form id="ForgotPasswordForm" asp-area="" asp-action="ForgotPasswordPost" asp-controller="Login" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="token" value="@Model" />
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="text" id="Email" name="email" class="form-control" />
                                    <span class="text-danger invalid-feedback" data-valmsg-for="email"></span>
                                </div>
                                <div class="mt-4">
                                    <button class="btn btn-primary w-100" type="submit"> <i id="btn_spin"></i> Forgot Password</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- end col -->
                <div class="col-lg-6">
                    <div class="p-lg-5 p-4 bg-white h-100">
                        <div class="position-relative h-100 d-flex flex-column justify-content-center align-items-center">
                            <div class="mb-0">
                                <a href="#" class="d-block">
                                    <img src="~/front/images/Logo.png" alt="" class="img-fluid">
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end col -->
            </div>
            <!-- end row -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->
</div>
<!-- end row -->

@section LoginScripts {
    <script>
        $(function() {
            $('#ForgotPasswordForm').submit(function(e) {
                e.preventDefault();
                $('.invalid-feedback').text('').removeClass('d-block');
                $('#ForgotPasswordForm').find('.is-invalid').removeClass('is-invalid');
                var fd = new FormData(this);
                $.ajax({
                    url: '@Url.Action("ForgotPasswordPost", "Login", new { area = "Admin" })',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    beforeSend: function() {
                        $("#btn_spin").addClass("spinner-border spinner-border-sm");
                    },
                    complete: function() {
                        $("#btn_spin").removeClass('spinner-border spinner-border-sm');
                    },
                    success: function(res) {
                        if (res && res.success) {
                            toastr.success(res.message);
                            $('#ForgotPasswordForm')[0].reset();
                            setTimeout(function() {
                                //window.location.href = res.redirectUrl;
                            }, 2500);
                        } else if (res && res.errors) {
                            $.each(res.errors, function(field, msgs) {
                                var key = field.split('.').pop();
                                        console.log(key);
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error(res.message || 'Save failed');
                    }, error: function(xhr) {
                        var json;
                        try {
                            json = xhr.responseJSON || JSON.parse(xhr.responseText);
                        } catch (e) {
                        } if (json && json.errors) {
                            $.each(json.errors, function(field, msgs) {
                                var key = field.split('.').pop();
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error('Server error');
                    }
                });

               
            });
        });
    </script>
}