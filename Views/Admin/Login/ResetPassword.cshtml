@model FoodOne.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Admin/Shared/_LayoutLogin.cshtml";
}
<div class="auth-page">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h4>Reset Password</h4>
                        @if (!Model.IsTokenValid)
                        {
                            <div class="alert alert-danger">
                                @Model.ErrorMessage
                            </div>
                            return;
                        }
                        <form id="ResetPasswordForm" asp-area="" asp-action="ResetPasswordPost" asp-controller="Login" method="post">
                            @Html.AntiForgeryToken()
                            <input asp-for="Token" type="hidden" />
                            <div class="mb-3">
                                <label class="form-label">New Password</label>
                                <input asp-for="NewPassword" class="form-control" type="password" />
                                <span asp-validation-for="NewPassword" class="text-danger invalid-feedback"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger invalid-feedback"></span>
                            </div>
                            <div>
                                <button class="btn btn-primary" type="submit"> <i id="btn_spin"></i> Reset Password</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section LoginScripts {
    <script>
        $(function() {
            $('#ResetPasswordForm').submit(function(e) {
                e.preventDefault();
                $('.invalid-feedback').text('').removeClass('d-block');
                $('#ResetPasswordForm').find('.is-invalid').removeClass('is-invalid');
                var fd = new FormData(this);
                $.ajax({
                    url: '@Url.Action("ResetPasswordPost", "Login", new { area = "Admin" })',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    beforeSend: function() {
                        $("#btn_spin").addClass("spinner-border spinner-border-sm");
                    },
                    complete: function() {
                        $("#btn_spin").removeClass('spinner-border spinner-border-sm');
                    },
                    success: function(res) {
                        if (res && res.success) {
                            toastr.success(res.message);
                            setTimeout(function() {
                                window.location.href = res.redirectUrl;
                            }, 2500);
                        } else if (res && res.errors) {
                            $.each(res.errors, function(field, msgs) {
                                var key = field.split('.').pop();
                                console.log(key);
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error(res.message || 'Save failed');
                    }, error: function(xhr) {
                        var json;
                        try {
                            json = xhr.responseJSON || JSON.parse(xhr.responseText);
                        } catch (e) {
                        } if (json && json.errors) {
                            $.each(json.errors, function(field, msgs) {
                                var key = field.split('.').pop();
                                $('[name="' + key + '"]').addClass('is-invalid');
                                $('span[data-valmsg-for="' + key + '"]').addClass('d-block').text(msgs[0]);
                            });
                        } else toastr.error('Server error');
                    }
                });

               
            });
        });
    </script>
}